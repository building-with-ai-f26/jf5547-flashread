# Copy this file to .env and fill in your keys:
#   copy .env.example .env
# NEVER commit your actual .env file to Git!
#
# Used by app/serve.ps1 for summary, quiz, and podcast script requests.
# The browser never receives this key. Leave it blank and speed reading still works.
# Podcast audio is spoken on this computer. There is no separate TTS key.

OPENROUTER_API_KEY=sk-or-v1-replace-with-your-key
