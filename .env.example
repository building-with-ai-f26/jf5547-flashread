# Copy this file to .env and fill in your keys:
#   copy .env.example .env
# NEVER commit your actual .env file to Git!
#
# Used only by app/serve.ps1 when you click "Summarize PDF with AI".
# The browser never receives this key. Leave it blank and the reader still works.

OPENROUTER_API_KEY=sk-or-v1-replace-with-your-key
